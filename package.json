{
  "name": "app",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "pnpm workflow run-check workflow-format --json",
    "harness-bootstrap": "node --experimental-strip-types packages/workflow-engine/bootstrap/harness-bootstrap-launcher.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "workflow": "node --experimental-strip-types packages/workflow-engine/bootstrap/workflow-launcher.ts",
    "workflow:build-human-gate-macos": "node --experimental-strip-types scripts/build-human-gate-macos.ts",
    "workflow:test": "node --experimental-strip-types scripts/workflow-full-gate.ts",
    "workflow:test:failures": "node --experimental-strip-types scripts/workflow-full-gate.ts --failures",
    "workflow:test:status": "node --experimental-strip-types scripts/workflow-full-gate.ts --status",
    "workflow:test:timings": "node --experimental-strip-types scripts/workflow-full-gate.ts --timings",
    "workflow:typecheck": "tsc -p packages/workflow-engine/tsconfig.json"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.6.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0"
  }
}
