{
  "schemaVersion": 3,
  "mode": "managed-read-only",
  "launchPolicy": "lifecycle-only",
  "requiredControls": [
    "separate-security-principal",
    "kernel-enforced-write-boundary",
    "git-common-directory-isolation",
    "network-egress-control",
    "secret-isolation",
    "subprocess-tree-confinement",
    "resource-limits",
    "immutable-runtime"
  ],
  "providers": {
    "codex": { "enabled": true },
    "claude": { "enabled": true }
  },
  "limits": {
    "timeoutMs": 300000,
    "aggregateOutputBytes": 1048576,
    "maxConcurrent": 2
  }
}
