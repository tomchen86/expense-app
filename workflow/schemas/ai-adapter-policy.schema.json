{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expense.local/workflow/ai-adapter-policy.schema.json",
  "title": "AI Adapter Evaluation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "launchPolicy",
    "requiredControls",
    "providers",
    "limits",
    "retryAccounting"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "mode": { "const": "managed-read-only" },
    "launchPolicy": { "const": "lifecycle-only" },
    "requiredControls": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "separate-security-principal" },
        { "const": "kernel-enforced-write-boundary" },
        { "const": "git-common-directory-isolation" },
        { "const": "network-egress-control" },
        { "const": "secret-isolation" },
        { "const": "subprocess-tree-confinement" },
        { "const": "resource-limits" },
        { "const": "immutable-runtime" }
      ],
      "items": false
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": { "$ref": "#/$defs/providerPolicy" },
        "claude": { "$ref": "#/$defs/providerPolicy" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "aggregateOutputBytes", "maxConcurrent"],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "aggregateOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    },
    "retryAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "maxCumulativeRuntimeMs",
        "maxProviderCostMicros",
        "maxProviderTokens",
        "maxSameFailureFingerprint",
        "maxRepairAttempts",
        "deadlineMs",
        "providerLimits",
        "reservations"
      ],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxCumulativeRuntimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400000
        },
        "maxProviderCostMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40000000
        },
        "maxProviderTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "maxSameFailureFingerprint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "maxRepairAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1209600000
        },
        "providerLimits": {
          "$ref": "#/$defs/providerLimits"
        },
        "reservations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codex", "claude"],
          "properties": {
            "codex": { "$ref": "#/$defs/providerReservation" },
            "claude": { "$ref": "#/$defs/providerReservation" }
          }
        }
      }
    }
  },
  "$defs": {
    "providerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "providerLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": { "type": "integer", "minimum": 1, "maximum": 4 },
        "claude": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "providerReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerCostMicros", "providerTokens"],
      "properties": {
        "providerCostMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "providerTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000
        }
      }
    }
  }
}
