{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expense.local/workflow/ai-adapter-policy.schema.json",
  "title": "AI Adapter Evaluation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "launchPolicy",
    "requiredControls",
    "providers",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mode": { "const": "evaluation-only" },
    "launchPolicy": { "const": "deny" },
    "requiredControls": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "separate-security-principal" },
        { "const": "kernel-enforced-write-boundary" },
        { "const": "git-common-directory-isolation" },
        { "const": "network-egress-control" },
        { "const": "secret-isolation" },
        { "const": "subprocess-tree-confinement" },
        { "const": "resource-limits" },
        { "const": "immutable-runtime" }
      ],
      "items": false
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": { "$ref": "#/$defs/providerPolicy" },
        "claude": { "$ref": "#/$defs/providerPolicy" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "aggregateOutputBytes", "maxConcurrent"],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "aggregateOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    }
  },
  "$defs": {
    "providerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
