{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expense-app.local/workflow/session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "state",
    "changeId",
    "taskId",
    "repositoryRoot",
    "gitCommonDirectory",
    "branch",
    "baseline",
    "artifacts",
    "allowedPaths",
    "requiredChecks",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "pattern": "^session-[A-Za-z0-9-]+$" },
    "state": { "enum": ["active", "aborted", "committed"] },
    "changeId": { "type": "string" },
    "taskId": { "type": "string" },
    "repositoryRoot": { "type": "string" },
    "gitCommonDirectory": { "type": "string" },
    "branch": { "type": "string" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree"],
      "properties": {
        "head": { "$ref": "#/$defs/commitHash" },
        "tree": { "$ref": "#/$defs/commitHash" }
      }
    },
    "artifacts": { "$ref": "#/$defs/digestRecord" },
    "allowedPaths": { "type": "array", "items": { "type": "string" } },
    "requiredChecks": { "type": "array", "items": { "type": "string" } },
    "requiredCheckDigests": { "$ref": "#/$defs/digestRecord" },
    "planningAssurance": { "$ref": "#/$defs/planningAssurance" },
    "createdAt": { "type": "string", "format": "date-time" },
    "latestCheckReportId": { "$ref": "#/$defs/digest" },
    "completionReportId": { "$ref": "#/$defs/digest" },
    "finishReportId": { "$ref": "#/$defs/digest" },
    "commitReportId": { "$ref": "#/$defs/digest" },
    "commitHash": { "$ref": "#/$defs/commitHash" },
    "committedAt": { "type": "string", "format": "date-time" },
    "abortedAt": { "type": "string", "format": "date-time" },
    "abortReason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "aborted" } } },
      "then": { "required": ["abortedAt", "abortReason"] }
    },
    {
      "if": { "properties": { "state": { "const": "committed" } } },
      "then": {
        "required": [
          "latestCheckReportId",
          "completionReportId",
          "finishReportId",
          "commitReportId",
          "commitHash",
          "committedAt"
        ]
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commitHash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "digestRecord": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "nullableDigest": {
      "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "planningAssurance": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicabilityKind",
            "applicabilityDigest",
            "applicabilityNodeId",
            "investigationBaseline",
            "planningGenerationId",
            "planTargetDigest",
            "reviewNodeId",
            "reviewResultDigest",
            "reviewDispositionNodeId",
            "reviewRoleResultDigest",
            "reviewRoleResultForm",
            "reviewOrchestration",
            "reviewGrantId",
            "reviewGrantEnvelopeDigest",
            "reviewGrantUseDigest",
            "reviewGrantTransitionDigest",
            "directHumanReviewAttestationDigest",
            "requiredIndependence",
            "achievedIndependence",
            "degradationAuthorized",
            "advisoryVerdict"
          ],
          "properties": {
            "applicabilityKind": {
              "enum": ["sealed-investigation", "investigation-exemption"]
            },
            "applicabilityDigest": { "$ref": "#/$defs/digest" },
            "applicabilityNodeId": { "$ref": "#/$defs/digest" },
            "investigationBaseline": {
              "type": "object",
              "additionalProperties": false,
              "required": ["head", "tree"],
              "properties": {
                "head": { "$ref": "#/$defs/commitHash" },
                "tree": { "$ref": "#/$defs/commitHash" }
              }
            },
            "planningGenerationId": { "$ref": "#/$defs/digest" },
            "planTargetDigest": { "$ref": "#/$defs/digest" },
            "reviewNodeId": { "$ref": "#/$defs/digest" },
            "reviewResultDigest": { "$ref": "#/$defs/digest" },
            "reviewDispositionNodeId": { "$ref": "#/$defs/nullableDigest" },
            "reviewRoleResultDigest": { "$ref": "#/$defs/digest" },
            "reviewRoleResultForm": {
              "enum": [
                "ordinary-provider",
                "granted-same-provider",
                "granted-caller-supplied",
                "direct-human-attestation"
              ]
            },
            "reviewOrchestration": {
              "enum": [
                "engine-spawned-provider",
                "caller-supplied",
                "direct-human-review"
              ]
            },
            "reviewGrantId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                { "type": "null" }
              ]
            },
            "reviewGrantEnvelopeDigest": { "$ref": "#/$defs/nullableDigest" },
            "reviewGrantUseDigest": { "$ref": "#/$defs/nullableDigest" },
            "reviewGrantTransitionDigest": { "$ref": "#/$defs/nullableDigest" },
            "directHumanReviewAttestationDigest": {
              "$ref": "#/$defs/nullableDigest"
            },
            "requiredIndependence": { "const": "provider-independent" },
            "achievedIndependence": {
              "enum": [
                "provider-independent",
                "principal-independent",
                "session-independent",
                "none"
              ]
            },
            "degradationAuthorized": { "type": "boolean" },
            "advisoryVerdict": {
              "enum": ["advisory-approve", "advisory-reject"]
            }
          }
        }
      ]
    }
  }
}
