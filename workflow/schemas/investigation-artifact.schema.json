{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expense-app.local/workflow/investigation-artifact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "changeId",
    "legacyMigration",
    "nodes",
    "currentRefs"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "kind": { "const": "investigation-artifact" },
    "changeId": { "$ref": "#/$defs/changeId" },
    "legacyMigration": { "type": "boolean" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceNode" }
    },
    "currentRefs": { "$ref": "#/$defs/currentRefs" },
    "applicability": { "$ref": "#/$defs/investigationApplicability" },
    "replay": { "$ref": "#/$defs/gitBackedReplay" },
    "roleResults": {
      "type": "array",
      "items": { "$ref": "#/$defs/admittedRoleResult" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": 1 } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": { "replay": false }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": 2 } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["applicability", "replay"],
        "properties": {
          "legacyMigration": { "const": false },
          "applicability": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "sealed-investigation" } }
          },
          "nodes": {
            "contains": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "const": "investigation-term-union" }
              }
            },
            "minContains": 1,
            "maxContains": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "investigation-term-scan",
                      "investigation-tree-inventory",
                      "investigation-hit",
                      "investigation-group",
                      "investigation-disposition",
                      "investigation-coverage"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "legacyMigration": { "const": true } },
        "required": ["legacyMigration"]
      },
      "then": {
        "properties": {
          "changeId": {
            "const": "establish-investigation-first-planning"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "changeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]+(?:[._:/-][a-zA-Z0-9]+)*$"
    },
    "digestMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/role" },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "currentRefs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/role" },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "pathIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawBase64", "utf8"],
      "properties": {
        "rawBase64": { "type": "string" },
        "utf8": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "groupSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectorId",
        "termId",
        "rootId",
        "extension",
        "mutationClass",
        "relationshipId",
        "splitId"
      ],
      "properties": {
        "selectorId": { "$ref": "#/$defs/digest" },
        "termId": { "$ref": "#/$defs/digest" },
        "rootId": { "type": "string", "minLength": 1 },
        "extension": { "$ref": "#/$defs/pathIdentity" },
        "mutationClass": {
          "enum": [
            "live",
            "prohibited",
            "generated",
            "mirror",
            "append-only",
            "immutable",
            "historical-reference"
          ]
        },
        "relationshipId": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "splitId": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "groupException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exceptionId",
        "hitId",
        "baseSelectorId",
        "splitId",
        "rationale",
        "author"
      ],
      "properties": {
        "exceptionId": { "type": "string", "minLength": 1 },
        "hitId": { "$ref": "#/$defs/digest" },
        "baseSelectorId": { "$ref": "#/$defs/digest" },
        "splitId": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 }
      }
    },
    "gitBackedReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "baseline",
        "fullNodeCount",
        "fullNodesDigest",
        "termUnionNodeId",
        "scan",
        "groups",
        "dispositions",
        "coverageNodeId"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "git-backed-investigation-replay" },
        "baseline": { "$ref": "#/$defs/baseline" },
        "fullNodeCount": { "type": "integer", "minimum": 1 },
        "fullNodesDigest": { "$ref": "#/$defs/digest" },
        "termUnionNodeId": { "$ref": "#/$defs/digest" },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeIds", "inventoryNodeId", "policyDigest"],
          "properties": {
            "nodeIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/digest" }
            },
            "inventoryNodeId": { "$ref": "#/$defs/digest" },
            "policyDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "policyDigest",
              "selector",
              "hitIds",
              "exceptions"
            ],
            "properties": {
              "nodeId": { "$ref": "#/$defs/digest" },
              "policyDigest": { "$ref": "#/$defs/digest" },
              "selector": { "$ref": "#/$defs/groupSelector" },
              "hitIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/digest" }
              },
              "exceptions": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/groupException" }
              }
            }
          }
        },
        "dispositions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "groupId",
              "classification",
              "rationale",
              "author"
            ],
            "properties": {
              "nodeId": { "$ref": "#/$defs/digest" },
              "groupId": { "$ref": "#/$defs/digest" },
              "classification": {
                "enum": [
                  "load-bearing",
                  "test-or-mirror",
                  "generated",
                  "incidental-reference",
                  "irrelevant"
                ]
              },
              "rationale": { "type": "string", "minLength": 1 },
              "author": { "type": "string", "minLength": 1 }
            }
          }
        },
        "coverageNodeId": { "$ref": "#/$defs/digest" }
      }
    },
    "investigationApplicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "kind",
            "baseline",
            "intentDigest",
            "sealNodeId",
            "sealResultDigest",
            "policyDigest",
            "applicabilityDigest"
          ],
          "properties": {
            "schemaVersion": { "const": 1 },
            "kind": { "const": "sealed-investigation" },
            "baseline": { "$ref": "#/$defs/baseline" },
            "intentDigest": { "$ref": "#/$defs/digest" },
            "sealNodeId": { "$ref": "#/$defs/digest" },
            "sealResultDigest": { "$ref": "#/$defs/digest" },
            "policyDigest": { "$ref": "#/$defs/digest" },
            "applicabilityDigest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "kind",
            "category",
            "baseline",
            "intentDigest",
            "declaredPaths",
            "declaredChangeClasses",
            "rationale",
            "semanticAuthor",
            "nonTrivialBehaviorReliance",
            "researchBudgetMinutes",
            "policyDigest",
            "applicabilityDigest"
          ],
          "properties": {
            "schemaVersion": { "const": 1 },
            "kind": { "const": "investigation-exemption" },
            "category": {
              "enum": [
                "documentation-only",
                "formatting-only",
                "deterministic-generated-projection",
                "time-boxed-research"
              ]
            },
            "baseline": { "$ref": "#/$defs/baseline" },
            "intentDigest": { "$ref": "#/$defs/digest" },
            "declaredPaths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "declaredChangeClasses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "documentation-only",
                  "formatting-only",
                  "deterministic-generated-projection",
                  "time-boxed-research"
                ]
              }
            },
            "rationale": { "type": "string", "minLength": 1 },
            "semanticAuthor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "provenance"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "provenance": { "type": "string", "minLength": 1 }
              }
            },
            "nonTrivialBehaviorReliance": { "const": "none-declared" },
            "researchBudgetMinutes": {
              "oneOf": [
                { "type": "null" },
                { "type": "integer", "minimum": 1, "maximum": 480 }
              ]
            },
            "policyDigest": { "$ref": "#/$defs/digest" },
            "applicabilityDigest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree"],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "admittedRoleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "form",
        "role",
        "targetDigest",
        "assignment",
        "author",
        "participant",
        "orchestration",
        "requiredIndependence",
        "achievedIndependence",
        "content",
        "providerInvocation",
        "grantUse",
        "directHumanReviewAttestation",
        "resultDigest"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "form": {
          "enum": [
            "ordinary-provider",
            "granted-same-provider",
            "granted-caller-supplied",
            "direct-human-attestation"
          ]
        },
        "role": { "enum": ["blind-surveyor", "plan-reviewer"] },
        "targetDigest": { "$ref": "#/$defs/digest" },
        "assignment": { "type": "object" },
        "author": { "type": "object" },
        "participant": { "type": "object" },
        "orchestration": {
          "enum": [
            "engine-spawned-provider",
            "caller-supplied",
            "direct-human-review"
          ]
        },
        "requiredIndependence": { "const": "provider-independent" },
        "achievedIndependence": {
          "enum": ["provider-independent", "session-independent", "none"]
        },
        "content": { "$ref": "#/$defs/roleContentAdmission" },
        "providerInvocation": {
          "oneOf": [{ "type": "null" }, { "type": "object" }]
        },
        "grantUse": {
          "oneOf": [{ "type": "null" }, { "type": "object" }]
        },
        "directHumanReviewAttestation": {
          "oneOf": [{ "type": "null" }, { "type": "object" }]
        },
        "resultDigest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "form": { "const": "ordinary-provider" } },
            "required": ["form"]
          },
          "then": {
            "properties": {
              "orchestration": { "const": "engine-spawned-provider" },
              "achievedIndependence": { "const": "provider-independent" },
              "providerInvocation": { "type": "object" },
              "grantUse": { "type": "null" },
              "directHumanReviewAttestation": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "form": { "const": "granted-same-provider" } },
            "required": ["form"]
          },
          "then": {
            "properties": {
              "orchestration": { "const": "engine-spawned-provider" },
              "achievedIndependence": { "const": "session-independent" },
              "providerInvocation": { "type": "object" },
              "grantUse": { "type": "object" },
              "directHumanReviewAttestation": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "form": { "const": "granted-caller-supplied" } },
            "required": ["form"]
          },
          "then": {
            "properties": {
              "orchestration": { "const": "caller-supplied" },
              "achievedIndependence": { "const": "none" },
              "providerInvocation": { "type": "null" },
              "grantUse": { "type": "object" },
              "directHumanReviewAttestation": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "form": { "const": "direct-human-attestation" } },
            "required": ["form"]
          },
          "then": {
            "properties": {
              "orchestration": { "const": "direct-human-review" },
              "achievedIndependence": { "const": "none" },
              "providerInvocation": { "type": "null" },
              "grantUse": { "type": "object" },
              "directHumanReviewAttestation": { "type": "object" }
            }
          }
        }
      ]
    },
    "roleContentAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nodeId",
        "resultDigest",
        "outputSchema",
        "evaluator",
        "policyDigest",
        "contentDigest",
        "current"
      ],
      "properties": {
        "kind": { "enum": ["blind-survey", "plan-review"] },
        "nodeId": { "$ref": "#/$defs/digest" },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "evaluator": { "type": "string", "minLength": 1 },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "current": { "const": true }
      }
    },
    "evidenceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeSchema",
        "nodeId",
        "type",
        "evaluator",
        "policyDigest",
        "exactInputDigests",
        "semanticParentResultDigests",
        "provenanceParentNodeIds",
        "outputSchema",
        "output",
        "resultDigest",
        "runtimeMetadata"
      ],
      "properties": {
        "nodeSchema": { "$ref": "#/$defs/label" },
        "nodeId": { "$ref": "#/$defs/digest" },
        "type": { "$ref": "#/$defs/label" },
        "evaluator": { "$ref": "#/$defs/label" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "exactInputDigests": { "$ref": "#/$defs/digestMap" },
        "semanticParentResultDigests": { "$ref": "#/$defs/digestMap" },
        "provenanceParentNodeIds": { "$ref": "#/$defs/digestMap" },
        "outputSchema": { "$ref": "#/$defs/label" },
        "output": true,
        "resultDigest": { "$ref": "#/$defs/digest" },
        "runtimeMetadata": {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        }
      }
    }
  }
}
