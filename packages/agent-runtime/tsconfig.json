{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@jigwright/core/canonical-json": ["../core/src/canonical-json.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
